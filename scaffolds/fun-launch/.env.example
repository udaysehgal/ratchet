# Solana RPC URL (Helius free tier works; public RPC is heavily rate-limited)
RPC_URL=your_rpc_url

# Network: devnet | mainnet (selects preset configs from src/presets/registry.json)
NEXT_PUBLIC_NETWORK=devnet

# Token image/metadata storage — use ONE of:
# 1) Vercel Blob (free on Hobby): connect a Blob store to the project; Vercel sets this automatically
BLOB_READ_WRITE_TOKEN=
# 2) Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=
